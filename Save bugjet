<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบบันทึกค่าใช้จ่ายงานรับเหมา</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;700&display=swap');
        body { font-family: 'Sarabun', sans-serif; }
    </style>
</head>
<body class="bg-gray-100 min-h-screen pb-10">
    <div class="max-w-md mx-auto bg-white min-h-screen shadow-lg flex flex-col">
        <!-- หัวข้อหลัก -->
        <div class="bg-blue-600 text-white p-5 rounded-b-2xl shadow-md text-center">
            <h1 class="text-xl font-bold"><i class="fa-solid fa-calculator mr-2"></i>บันทึกค่าใช้จ่ายงานรับเหมา</h1>
        </div>
        
        <!-- แสดงยอดรวม -->
        <div class="mx-4 -mt-5 bg-gradient-to-r from-emerald-500 to-teal-600 text-white p-5 rounded-xl shadow-lg text-center">
            <p class="text-sm opacity-90">รวมค่าใช้จ่ายทั้งหมด</p>
            <p class="text-3xl font-extrabold mt-1" id="totalAmount">0.00 บาท</p>
        </div>

        <!-- ฟอร์มกรอกข้อมูล -->
        <div class="p-4 mt-2">
            <div class="bg-gray-50 p-4 rounded-xl border border-gray-200 shadow-sm">
                <h3 class="font-bold text-gray-700 mb-3"><i class="fa-solid fa-plus-circle mr-1 text-blue-500"></i> เพิ่มรายการใหม่</h3>
                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">หมวดหมู่</label>
                        <select id="category" class="w-full p-2.5 bg-white border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                            <option value="🏗️ ค่าวัสดุก่อสร้าง">🏗️ ค่าวัสดุก่อสร้าง (ท่อ HDPE, ปูน, เหล็ก)</option>
                            <option value="👷 ค่าแรงและทีมช่าง">👷 ค่าแรงและทีมช่าง / ผู้รับเหมาช่วง</option>
                            <option value="🚜 ค่าเครื่องจักรและขนส่ง">🚜 ค่าเครื่องจักร / ค่าน้ำมัน / ขนส่ง</option>
                            <option value="💰 ค่าใช้จ่ายอื่นๆ">💰 ค่าใช้จ่ายอื่นๆ</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">รายละเอียดรายการ</label>
                        <input type="text" id="description" placeholder="เช่น ค่าท่อ HDPE, ค่าแรงช่าง" class="w-full p-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">จำนวนเงิน (บาท)</label>
                        <input type="number" id="amount" placeholder="0.00" class="w-full p-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <button onclick="addItem()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-lg text-sm transition-colors shadow-md">
                        บันทึกรายการ
                    </button>
                </div>
            </div>
        </div>

        <!-- ปุ่มแชร์และส่งออกข้อมูล -->
        <div class="px-4 grid grid-cols-2 gap-2 mb-2">
            <button onclick="shareToLine()" class="bg-[#06C755] hover:bg-[#05b34c] text-white font-bold py-2.5 px-3 rounded-xl text-xs shadow flex items-center justify-center gap-1.5 transition-all">
                <i class="fa-brands fa-line text-sm"></i> ส่งออกไป LINE
            </button>
            <button onclick="shareToMessenger()" class="bg-[#0084FF] hover:bg-[#0072dd] text-white font-bold py-2.5 px-3 rounded-xl text-xs shadow flex items-center justify-center gap-1.5 transition-all">
                <i class="fa-brands fa-facebook-messenger text-sm"></i> ส่ง Messenger
            </button>
        </div>

        <div class="px-4 grid grid-cols-2 gap-2 mb-2">
            <button onclick="exportToExcel()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-3 rounded-xl text-xs shadow flex items-center justify-center gap-1.5 transition-all">
                <i class="fa-solid fa-file-excel text-sm"></i> ดาวน์โหลด Excel
            </button>
            <button onclick="clearAll()" class="bg-red-50 hover:bg-red-100 text-red-600 font-bold py-2 px-3 rounded-xl text-xs border border-red-200 flex items-center justify-center gap-1.5 transition-all">
                <i class="fa-solid fa-trash-can text-sm"></i> ล้างข้อมูลทั้งหมด
            </button>
        </div>

        <!-- รายการที่บันทึก -->
        <div class="p-4 flex-1">
            <h3 class="font-bold text-gray-700 mb-3"><i class="fa-solid fa-list-ul mr-1 text-gray-500"></i> รายการที่บันทึกไว้</h3>
            <div id="itemList" class="space-y-2"></div>
        </div>
    </div>

    <script>
        let items = JSON.parse(localStorage.getItem('construction_expenses')) || [];

        function addItem() {
            const category = document.getElementById('category').value;
            const description = document.getElementById('description').value.trim();
            const amount = parseFloat(document.getElementById('amount').value);

            if (!description || isNaN(amount) || amount <= 0) { 
                alert('กรุณากรอกรายละเอียดและจำนวนเงินให้ถูกต้องครับ'); 
                return; 
            }

            items.push({ 
                id: Date.now(), 
                category, 
                description, 
                amount, 
                date: new Date().toLocaleDateString('th-TH') 
            });

            localStorage.setItem('construction_expenses', JSON.stringify(items));
            updateUI();
            
            document.getElementById('description').value = '';
            document.getElementById('amount').value = '';
        }

        function deleteItem(id) { 
            if(confirm('คุณต้องการลบรายการนี้ใช่หรือไม่?')) { 
                items = items.filter(item => item.id !== id); 
                localStorage.setItem('construction_expenses', JSON.stringify(items)); 
                updateUI(); 
            } 
        }

        function clearAll() { 
            if(confirm('⚠️ ต้องการลบข้อมูลทั้งหมดที่เคยบันทึกไว้ใช่หรือไม่?')) { 
                items = []; 
                localStorage.setItem('construction_expenses', JSON.stringify(items)); 
                updateUI(); 
            } 
        }

        // ฟังก์ชันสร้างข้อความสรุปรายจ่าย
        function generateReportText() {
            let today = new Date().toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });
            let text = "📊 รายงานค่าใช้จ่ายงานรับเหมา\nประจำวันที่: " + today + "\n-------------------------\n";
            let total = 0;
            
            items.forEach((item, index) => { 
                text += (index + 1) + ". " + item.description + "\n   ↳ [" + item.category + "] " + item.amount.toLocaleString() + " บาท\n"; 
                total += item.amount; 
            });
            text += "-------------------------\n💰 รวมทั้งสิ้น: " + total.toLocaleString() + " บาท";
            return text;
        }

        function shareToLine() {
            if (items.length === 0) { alert('ยังไม่มีข้อมูลให้ส่งออกครับ'); return; }
            let text = generateReportText();
            window.open("https://line.me/R/share?text=" + encodeURIComponent(text), '_blank');
        }

        function shareToMessenger() {
            if (items.length === 0) { alert('ยังไม่มีข้อมูลให้ส่งออกครับ'); return; }
            let text = generateReportText();
            
            // ใช้ระบบคัดลอกข้อความลงคลิปบอร์ดให้อัตโนมัติ เพื่อให้พี่ช่างกดวางใน Messenger ได้เลยทันที
            navigator.clipboard.writeText(text).then(() => {
                alert('คัดลอกรายงานรายจ่ายลงเครื่องแล้ว! ระบบจะเปิด Messenger ให้ พี่ช่างสามารถกด "วาง (Paste)" เพื่อส่งแชทได้เลยครับ');
                // เปิดแอป Messenger (หรือหน้าเว็บ Messenger)
                window.open("https://m.me/", '_blank');
            }).catch(err => {
                // กรณีเบราว์เซอร์ไม่รองรับการก๊อปปี้อัตโนมัติ ให้เปิดแอปตรง ๆ
                window.open("https://m.me/", '_blank');
            });
        }

        function exportToExcel() {
            if (items.length === 0) { alert('ยังไม่มีข้อมูลให้ส่งออกเป็น Excel ครับ'); return; }
            let csvContent = "\uFEFFวันที่,หมวดหมู่,รายละเอียดรายการ,จำนวนเงิน (บาท)\n";
            let total = 0;
            
            items.forEach(item => { 
                csvContent += '"' + item.date + '","' + item.category + '","' + item.description.replace(/"/g, '""') + '",' + item.amount + "\n"; 
                total += item.amount; 
            });
            csvContent += ",,,\n,,รวมทั้งสิ้น," + total + "\n";
            
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", "บันทึกค่าใช้จ่ายงานรับเหมา.csv");
            link.click();
        }

        function updateUI() {
            const itemList = document.getElementById('itemList');
            const totalAmount = document.getElementById('totalAmount');
            itemList.innerHTML = '';

            if (items.length === 0) { 
                itemList.innerHTML = '<p class="text-gray-400 text-center py-8 text-sm">ยังไม่มีการบันทึกรายการ</p>'; 
                totalAmount.innerText = '0.00 บาท'; 
                return; 
            }

            let total = 0;
            [...items].reverse().forEach(item => {
                total += item.amount;
                const itemDiv = document.createElement('div');
                itemDiv.className = "bg-gray-50 p-3 rounded-xl border border-gray-200 shadow-sm flex justify-between items-center";
                itemDiv.innerHTML = '<div><p class="font-bold text-gray-800 text-sm">' + item.description + '</p><span class="bg-blue-100 text-blue-700 text-[10px] px-2 py-0.5 rounded-full">' + item.category + '</span></div><div class="flex items-center gap-3"><span class="font-bold text-emerald-600 text-sm">' + item.amount.toLocaleString() + ' บ.</span><button onclick="deleteItem(' + item.id + ')" class="text-gray-400 hover:text-red-500"><i class="fa-solid fa-trash-can"></i></button></div>';
                itemList.appendChild(itemDiv);
            });
            totalAmount.innerText = total.toLocaleString() + ' บาท';
        }

        updateUI();
    </script>
</body>
</html>
